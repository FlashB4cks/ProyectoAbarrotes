# =======================================================
# Variables de Entorno - NohemySys (Docker / Producción)
# =======================================================
# Copie este archivo como .env si desea personalizar credenciales:
# cp .env.example .env

# Base de Datos PostgreSQL (Opción 1: Supabase / URL Completa)
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Base de Datos PostgreSQL (Opción 2: Parámetros Individuales / Local Docker)
DB_NAME=nohemysys_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=prefer

# Backend Django
DEBUG=False
SECRET_KEY=django-insecure-production-super-secret-key-change-me-pos-2026
RUN_MIGRATIONS=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,*
CORS_ALLOWED_ORIGINS=https://tu-proyecto.vercel.app
CSRF_TRUSTED_ORIGINS=https://tu-proyecto.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Frontend (Vercel / Local)
PORT=80
VITE_API_URL=https://tu-backend.onrender.com/api
BACKEND_PROXY_URL=http://backend:8000/api/
